      "text": ["Merge Sort in Python", "equal keys keep their order", ["Θ(n) extra memory", "\\Theta(n) extra memory"]],
      "code": {
        "language": "python",
        "lines": [
          "def merge_sort(a):",
          "if len(a) <= 1:",
          "mid = len(a) // 2",
          "left = merge_sort(a[:mid])",
          "right = merge_sort(a[mid:])",
          "return merge(left, right)",
          "def merge(left, right):",
          "out, i, j = [], 0, 0",
          "while i < len(left) and j < len(right):",
          "if left[i] <= right[j]:",
          "out.append(left[i]); i += 1",
          "return out + left[i:] + right[j:]"
        ]
      }
