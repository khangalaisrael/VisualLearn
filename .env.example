# Copy this file to .env and fill in real values before running
# `docker compose up` (see docker-compose.yml and docs/adr/ADR-007-local-first-deployment.md).

# --- PostgreSQL (docker-compose.yml `db` service) ---
POSTGRES_USER=visionlearn
POSTGRES_PASSWORD=visionlearn
POSTGRES_DB=visionlearn

# --- Backend (backend/app/core/config.py) ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# Shared secret between the extension and this backend. This is the only
# access control on the local API (see ADR-007) — set it to a real random
# value, then configure the same value in the extension
# (extension/README.md § Backend connection).
LOCAL_API_KEY=change-me-to-a-random-value

# Required for real slide analysis (Milestone 2). Set OPENAI_API_KEY,
# ANTHROPIC_API_KEY, or both — OpenAI is used if present (see
# docs/adr/ADR-009-openai-as-active-vlm-provider.md), Anthropic otherwise.
# For the cheapest setup, set only ANTHROPIC_API_KEY (Claude Haiku 5.5 by
# default — see ANTHROPIC_VLM_MODEL below).
# Leave both empty to run with the no-op PlaceholderSlideAnalyzer instead —
# the backend still works, GET /health will just report model_provider: false.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which OpenAI model handles slide capture analysis (backend/app/core/config.py).
# gpt-4o (default): higher accuracy, ~$0.01-0.017 per capture.
# gpt-4o-mini: ~16x cheaper per *text* token, but image inputs are billed at
# a large token multiplier, so a slide capture still costs ~$0.005-0.006 —
# only modestly cheaper than gpt-4o, and weaker at dense equations/diagrams.
# Leave unset to use gpt-4o.
OPENAI_VLM_MODEL=

# Which OpenAI model handles Ask-tab chat (backend/app/core/config.py).
# Same gpt-4o / gpt-4o-mini tradeoff as OPENAI_VLM_MODEL, set independently.
# Leave unset to use gpt-4o.
OPENAI_CHAT_MODEL=

# Which Claude models are used when Anthropic is the active provider
# (ANTHROPIC_API_KEY set, OPENAI_API_KEY empty).
# claude-haiku-5-5 (default): $0.10/$0.50 per MTok — ~$0.001 per capture,
#   roughly 5x cheaper than gpt-4o-mini for slide images.
# claude-sonnet-5-5: $2/$10 per MTok — more accurate on dense slides, ~20x the cost.
# Leave unset to use claude-haiku-5-5.
ANTHROPIC_VLM_MODEL=
ANTHROPIC_CHAT_MODEL=

# --- Production only (docker-compose.prod.yml, docs/DEPLOY.md) ---
# Public hostname Caddy serves and gets a Let's Encrypt certificate for.
# Must have a DNS A record pointing at the VM's public IP. No domain? Use
# <ip-with-dashes>.sslip.io (e.g. 129-146-1-2.sslip.io) — resolves to that IP.
DOMAIN=
# Required by the Caddyfile: Let's Encrypt account + expiry notices.
ACME_EMAIL=

# Shown on the public privacy policy page (GET /privacy). Without it the page
# points to the Chrome Web Store listing's support contact instead.
PRIVACY_CONTACT_EMAIL=

# Comma-separated Google emails that are never rate limited.
ADMIN_EMAILS=
# Captures allowed across all users per day; limits reset at midnight in this timezone.
GLOBAL_CAPTURES_PER_DAY=250
RATE_LIMIT_TIMEZONE=Africa/Johannesburg
